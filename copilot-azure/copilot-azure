#!/usr/bin/env bash
set -euo pipefail

AZURE_FOUNDRY_RESOURCE_NAME="your-azure-foundry-resource-name"
# Resource group name is only needed if you don't want to
# set COPILOT_PROVIDER_API_KEY. If that env var isn't set,# the script will use the Azure CLI to fetch the API key.
AZURE_RESOURCE_GROUP_NAME="your-azure-resource-group"

die() {
  echo "Error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: copilot-azure [model-deployment-name] [copilot-args...]

Examples:
  copilot-azure
  copilot-azure gpt-5.6-terra
  copilot-azure gpt-5.6-terra --help
  copilot-azure gpt-5.6-luna --some-copilot-flag
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

pricing_file="$HOME/.copilot/azure-pricing-status-line/foundry-model-pricing.csv"
[[ -f "$pricing_file" ]] || die "Pricing file not found at '$pricing_file'."

models=()
model_prices=()
name_width=0
price_width=0
while IFS=, read -r model_key aliases input_per_1m cached_input_per_1m cache_write_per_1m output_per_1m || [[ -n "$model_key" ]]; do
  model_key="${model_key%$'\r'}"
  if [[ -n "$model_key" && "$model_key" != "model_key" ]]; then
    models+=("$model_key")
    price=''
    output_per_1m="${output_per_1m%$'\r'}"
    if [[ -n "$input_per_1m" && -n "$cached_input_per_1m" && -n "$cache_write_per_1m" && -n "$output_per_1m" ]]; then
      price="\$${input_per_1m%.00} / \$${cached_input_per_1m%.00} / \$${cache_write_per_1m%.00} / \$${output_per_1m%.00}"
    fi
    model_prices+=("$price")
    if (( ${#model_key} > name_width )); then name_width=${#model_key}; fi
    if (( ${#price} > price_width )); then price_width=${#price}; fi
  fi
done < "$pricing_file"
[[ ${#models[@]} -gt 0 ]] || die "No models found in '$pricing_file'."

if [[ $# -eq 0 ]]; then
  [[ -t 0 && -t 2 ]] || die "Model selection requires a terminal. Pass a model name directly instead."
  terminal_width=$(tput cols 2>/dev/null || printf '80')
  show_prices=false
  if (( price_width > 0 && name_width + price_width + 5 < terminal_width )); then show_prices=true; fi
  tput civis >&2 || true
  trap 'tput cnorm >&2 || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  echo "Choose a model (Up/Down, Enter; Esc to cancel):" >&2
  if [[ "$show_prices" == true ]]; then echo 'Prices: USD per 1M tokens (in / cached / cache write / out)' >&2; fi
  current=0
  draw_models() {
    for index in "${!models[@]}"; do
      marker=' '
      [[ "$index" -eq "$current" ]] && marker='>'
      if [[ "$show_prices" == true ]]; then
        printf ' %s %-*s  %s\033[K\n' "$marker" "$name_width" "${models[$index]}" "${model_prices[$index]}" >&2
      else
        printf ' %s %s\033[K\n' "$marker" "${models[$index]}" >&2
      fi
    done
  }
  draw_models
  while true; do
    IFS= read -rsn1 key || die "No model selected."
    if [[ "$key" == $'\e' ]]; then
      sequence=''
      IFS= read -rsN2 -t 1 sequence || true
      case "$sequence" in
        '[A'|'OA')
          if (( current > 0 )); then current=$((current - 1)); fi ;;
        '[B'|'OB')
          if (( current < ${#models[@]} - 1 )); then current=$((current + 1)); fi ;;
        '') die "No model selected." ;;
      esac
    elif [[ -z "$key" || "$key" == $'\r' ]]; then
      break
    elif [[ "$key" == 'k' ]]; then
      if (( current > 0 )); then current=$((current - 1)); fi
    elif [[ "$key" == 'j' ]]; then
      if (( current < ${#models[@]} - 1 )); then current=$((current + 1)); fi
    fi
    printf '\033[%dA' "${#models[@]}" >&2
    draw_models
  done
  tput cnorm >&2 || true
  trap - EXIT INT TERM
  deployment_name="${models[$current]}"
  printf 'Launching Copilot CLI...\n' >&2
else
  deployment_name="$1"
  shift
  found=false
  for model in "${models[@]}"; do
    if [[ "$model" == "$deployment_name" ]]; then
      found=true
      break
    fi
  done
  [[ "$found" == true ]] || die "Model '$deployment_name' is not in '$pricing_file'."
fi

fetch_api_key_from_azure() {
  az cognitiveservices account keys list \
    --name "$AZURE_FOUNDRY_RESOURCE_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP_NAME" \
    --query key1 -o tsv 2>/dev/null
}

resolve_api_key() {
  if [[ -n "${COPILOT_PROVIDER_API_KEY:-}" ]]; then
    return 0
  fi

  if ! command -v az >/dev/null 2>&1; then
    die "Azure CLI ('az') not found. Install it, or set COPILOT_PROVIDER_API_KEY."
  fi

  COPILOT_PROVIDER_API_KEY="$(fetch_api_key_from_azure)"

  if [[ -z "$COPILOT_PROVIDER_API_KEY" ]]; then
    die "Could not fetch a key for '$AZURE_FOUNDRY_RESOURCE_NAME' in '$AZURE_RESOURCE_GROUP_NAME'. Run 'az login', or set COPILOT_PROVIDER_API_KEY."
  fi
}

resolve_api_key

export COPILOT_PROVIDER_TYPE="azure"
export COPILOT_PROVIDER_BASE_URL="https://${AZURE_FOUNDRY_RESOURCE_NAME}.openai.azure.com/openai/deployments/${deployment_name}"
export COPILOT_PROVIDER_API_KEY
export COPILOT_PROVIDER_WIRE_API="responses"
export COPILOT_MODEL="${deployment_name}"

exec copilot "$@"
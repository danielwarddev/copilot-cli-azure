#!/usr/bin/env bash
set -euo pipefail

AZURE_FOUNDRY_RESOURCE_NAME="your-azure-foundry-resource-name"
# Resource group name is only needed if you don't want to
# set COPILOT_PROVIDER_API_KEY. If that env var isn't set,# the script will use the Azure CLI to fetch the API key.
AZURE_RESOURCE_GROUP_NAME="your-azure-resource-group"

die() {
  echo "Error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: caz [model-deployment-name] [copilot-args...]

Examples:
  caz
  caz gpt-5.6-terra
  caz gpt-5.6-terra --help
  caz gpt-5.6-luna --some-copilot-flag
EOF
}

printf '\n=== Copilot CLI (BYOK) with Azure Foundry models ===\n' >&2

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

pricing_file="$HOME/.copilot/azure-pricing-status-line/foundry-model-pricing.csv"
[[ -f "$pricing_file" ]] || die "Pricing file not found at '$pricing_file'."

models=()
input_prices=()
output_prices=()
cache_read_prices=()
cache_write_prices=()
base_models=()
effort_options=()
effort_indexes=()
model_labels=()
name_width=14
input_width=2
output_width=3
cache_read_width=10
cache_write_width=11
has_prices=false
while IFS=, read -r model_key aliases input_per_1m cached_input_per_1m cache_write_per_1m output_per_1m base_model reasoning_efforts default_reasoning_effort || [[ -n "$model_key" ]]; do
  model_key="${model_key%$'\r'}"
  if [[ -n "$model_key" && "$model_key" != "model_key" ]]; then
    models+=("$model_key")
    base_models+=("${base_model%$'\r'}")
    reasoning_efforts="${reasoning_efforts%$'\r'}"
    default_reasoning_effort="${default_reasoning_effort%$'\r'}"
    options=''
    effort_index=0
    label="$model_key [N/A]"
    if [[ -n "$reasoning_efforts" ]]; then
      IFS='|' read -r -a levels <<< "$reasoning_efforts"
      for level in "${levels[@]}"; do
        case "$level" in
          none|minimal|low|medium|high|xhigh|max) options+="${options:+|}$level" ;;
          *) die "Invalid reasoning effort '$level' for '$model_key'." ;;
        esac
      done
    fi
    if [[ -n "$options" ]]; then
      IFS='|' read -r -a levels <<< "$options"
      starting_effort="${default_reasoning_effort:-medium}"
      matched=false
      for level_index in "${!levels[@]}"; do
        if [[ "${levels[$level_index]}" == "$starting_effort" ]]; then
          effort_index=$level_index
          matched=true
        fi
        candidate_label="$model_key [${levels[$level_index]}]"
        if (( ${#candidate_label} > name_width )); then name_width=${#candidate_label}; fi
      done
      if [[ -n "$default_reasoning_effort" && "$matched" == false ]]; then
        die "Invalid default reasoning effort '$default_reasoning_effort' for '$model_key'."
      fi
      label="$model_key [${levels[$effort_index]}]"
    elif [[ -n "$default_reasoning_effort" ]]; then
      die "Invalid default reasoning effort '$default_reasoning_effort' for '$model_key'."
    fi
    effort_options+=("$options")
    effort_indexes+=("$effort_index")
    model_labels+=("$label")
    input_price=''
    output_price=''
    cache_read_price=''
    cache_write_price=''
    output_per_1m="${output_per_1m%$'\r'}"
    if [[ -n "$input_per_1m" && -n "$cached_input_per_1m" && -n "$cache_write_per_1m" && -n "$output_per_1m" ]]; then
      input_price="\$${input_per_1m%.00}"
      output_price="\$${output_per_1m%.00}"
      cache_read_price="\$${cached_input_per_1m%.00}"
      cache_write_price="\$${cache_write_per_1m%.00}"
      has_prices=true
    fi
    input_prices+=("$input_price")
    output_prices+=("$output_price")
    cache_read_prices+=("$cache_read_price")
    cache_write_prices+=("$cache_write_price")
    if (( ${#label} > name_width )); then name_width=${#label}; fi
    if (( ${#input_price} > input_width )); then input_width=${#input_price}; fi
    if (( ${#output_price} > output_width )); then output_width=${#output_price}; fi
    if (( ${#cache_read_price} > cache_read_width )); then cache_read_width=${#cache_read_price}; fi
    if (( ${#cache_write_price} > cache_write_width )); then cache_write_width=${#cache_write_price}; fi
  fi
done < "$pricing_file"
[[ ${#models[@]} -gt 0 ]] || die "No models found in '$pricing_file'."

if [[ $# -eq 0 || "${1:-}" == -* ]]; then
  [[ -t 0 && -t 2 ]] || die "Model selection requires a terminal. Pass a model name directly instead."
  terminal_width=$(tput cols 2>/dev/null || printf '80')
  show_prices=false
  if [[ "$has_prices" == true ]] && (( 3 + name_width + input_width + output_width + cache_read_width + cache_write_width + 12 < terminal_width )); then show_prices=true; fi
  tput civis >&2 || true
  trap 'tput cnorm >&2 || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  printf '\nChoose a model (Up/Down; Left/Right effort; Enter; Esc to cancel):\n\n' >&2
  if [[ "$show_prices" == true ]]; then
    printf 'Costs are in USD and per 1M tokens\n' >&2
    printf '   %-*s   %-*s   %-*s   %-*s   %s\n' "$name_width" 'model [effort]' "$input_width" 'in' "$output_width" 'out' "$cache_read_width" 'cache read' 'cache write' >&2
    printf -v divider '%*s' "$((name_width + input_width + output_width + cache_read_width + cache_write_width + 12))" ''
    printf '   %s\n' "${divider// /-}" >&2
  fi
  current=0
  draw_models() {
    for index in "${!models[@]}"; do
      marker=' '
      [[ "$index" -eq "$current" ]] && marker='>'
      if [[ "$show_prices" == true ]]; then
        printf ' %s %-*s   %-*s   %-*s   %-*s   %s\033[K\n' "$marker" "$name_width" "${model_labels[$index]}" "$input_width" "${input_prices[$index]}" "$output_width" "${output_prices[$index]}" "$cache_read_width" "${cache_read_prices[$index]}" "${cache_write_prices[$index]}" >&2
      else
        printf ' %s %s\033[K\n' "$marker" "${model_labels[$index]}" >&2
      fi
    done
  }
  draw_models
  cycle_effort() {
    IFS='|' read -r -a levels <<< "${effort_options[$current]}"
    if (( ${#levels[@]} > 1 )); then
      next=$(( (effort_indexes[current] + $1 + ${#levels[@]}) % ${#levels[@]} ))
      effort_indexes[$current]=$next
      model_labels[$current]="${models[$current]} [${levels[$next]}]"
    fi
  }
  while true; do
    IFS= read -rsn1 key || die "No model selected."
    if [[ "$key" == $'\e' ]]; then
      sequence=''
      IFS= read -rsN2 -t 1 sequence || true
      case "$sequence" in
        '[A'|'OA')
          if (( current > 0 )); then current=$((current - 1)); fi ;;
        '[B'|'OB')
          if (( current < ${#models[@]} - 1 )); then current=$((current + 1)); fi ;;
        '[C'|'OC') cycle_effort 1 ;;
        '[D'|'OD') cycle_effort -1 ;;
        '') die "No model selected." ;;
      esac
    elif [[ -z "$key" || "$key" == $'\r' ]]; then
      break
    elif [[ "$key" == 'k' ]]; then
      if (( current > 0 )); then current=$((current - 1)); fi
    elif [[ "$key" == 'j' ]]; then
      if (( current < ${#models[@]} - 1 )); then current=$((current + 1)); fi
    fi
    printf '\033[%dA' "${#models[@]}" >&2
    draw_models
  done
  tput cnorm >&2 || true
  trap - EXIT INT TERM
  deployment_name="${models[$current]}"
  IFS='|' read -r -a levels <<< "${effort_options[$current]}"
  selected_effort="${levels[${effort_indexes[$current]}]:-}"
  has_effort_arg=false
  for argument in "$@"; do
    if [[ "$argument" == --reasoning-effort || "$argument" == --reasoning-effort=* ]]; then
      has_effort_arg=true
      break
    fi
  done
  if [[ -n "$selected_effort" && "$has_effort_arg" == false ]]; then
    set -- --reasoning-effort "$selected_effort" "$@"
  fi
  selected_index=$current
  printf 'Launching Copilot CLI...\n' >&2
else
  deployment_name="$1"
  shift
  found=false
  for index in "${!models[@]}"; do
    if [[ "${models[$index]}" == "$deployment_name" ]]; then
      found=true
      selected_index=$index
      break
    fi
  done
  [[ "$found" == true ]] || die "Model '$deployment_name' is not in '$pricing_file'."
fi

fetch_api_key_from_azure() {
  az cognitiveservices account keys list \
    --name "$AZURE_FOUNDRY_RESOURCE_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP_NAME" \
    --query key1 -o tsv 2>/dev/null
}

resolve_api_key() {
  if [[ -n "${COPILOT_PROVIDER_API_KEY:-}" ]]; then
    return 0
  fi

  if ! command -v az >/dev/null 2>&1; then
    die "Azure CLI ('az') not found. Install it, or set COPILOT_PROVIDER_API_KEY."
  fi

  COPILOT_PROVIDER_API_KEY="$(fetch_api_key_from_azure)"

  if [[ -z "$COPILOT_PROVIDER_API_KEY" ]]; then
    die "Could not fetch a key for '$AZURE_FOUNDRY_RESOURCE_NAME' in '$AZURE_RESOURCE_GROUP_NAME'. Run 'az login', or set COPILOT_PROVIDER_API_KEY."
  fi
}

resolve_api_key

export COPILOT_PROVIDER_TYPE="azure"
export COPILOT_PROVIDER_BASE_URL="https://${AZURE_FOUNDRY_RESOURCE_NAME}.openai.azure.com/openai/deployments/${deployment_name}"
export COPILOT_PROVIDER_API_KEY
export COPILOT_PROVIDER_WIRE_API="responses"
export COPILOT_MODEL="${deployment_name}"
export COPILOT_PROVIDER_MODEL_ID="${base_models[$selected_index]:-$deployment_name}"
export COPILOT_PROVIDER_WIRE_MODEL="$deployment_name"

exec copilot "$@"